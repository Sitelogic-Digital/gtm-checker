# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://lactiq.co.uk

# Resend (https://resend.com). The sending domain must be verified.
RESEND_API_KEY=
RESEND_FROM="Lactiq <hello@lactiq.co.uk>"
NOTIFY_EMAIL=hello@lactiq.co.uk

# Google Sheet webhook (Apps Script web app URL, see README). Receives JSON POSTs.
SHEET_WEBHOOK_URL=
# Shared secret sent to the webhook as "secret" so only this site can write
SHEET_WEBHOOK_SECRET=

# Long random string used to sign unsubscribe links (openssl rand -hex 32)
UNSUBSCRIBE_SECRET=

# Optional
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=lactiq.co.uk
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
